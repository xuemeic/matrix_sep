function output = gen_matrix_sep_2d(M, G1, G2, lam, para)
% generalized matrix separation solved by ADMM
% min||L||_* + lam||S||_1, subject to, L + HS = M, 
% H = G2 otimes G1 = kron(G2, G1)
% H is theoretically m1m2 x p1p2 
% input: 
%   M: a given 3D matrix: m1 x m2 x K
%   Gi: given matrix: mi x pi
%   lam: positive scalar, as described above
%   para has fields: 
%       .rho_outer: step size for ADMM, provided by user
%       .max_iter: max number of iterations for ADMM
%       .tol_outer: convergence tolerance for ADMM
%       .preconditioned: true or false. If true, H has been preconditioned
%       with all singular values to be 1
%       .is_E
%       .lasso_method: {'ADMM', 'FISTA'}
%       .lasso_rho: step size for lasso if lasso_method is ADMM
%       .lasso_max_iter: max num of iterations for lasso
%       .lasso_tol: convergence tolerance for lasso

%%%%%%%%%%%%%%%%%% notes %%%%%%%%%%%%%%%%%%%
% para.preconditioned needs to be provided by user!
% para.is_E needs to be provided by user!
% as of 8/10/2025, para.lasso_method = 'FISTA' only works when
% preconditioned

% output has fields
% - L: m x n
% - S: p x n
% - count_outer
% - para: similar to input with possibly more fields

% written by Owen Deen, 11/23/2024
% updated on 4/22/2025
% updated on 5/15/2025: does not work using E1 and E2
% updated on 5/16/2025: Ei work now. In genral, recommend to set para.is_E
% = false
% updated on 7/5/2025: bilinear_framewise(Video, G1', G2) is computed
% outside of loop
% updated on 7/17/2025: E1, E2 don't have to be circulant
% updated on 7/19/2025: changed output
% updated on 8/10/2025: use my_lasso2()



[m1, m2, K] = size(M);
[~, p1] = size(G1);
[~, p2] = size(G2);
%% default parameter values without user input
rho_outer_default = 1;
max_iter_default = 200;
tol_outer_default = 1e-7;
lasso_method_default = 'ADMM';
lasso_rho_default = 1; % if using ADMM
lasso_tol_default = 1e-5;
lasso_max_iter_default = 20;

%% pass the parameters
if ~isfield(para, 'preconditioned')
    error('Please specify "para.preconditioned" value.')
end

if ~isfield(para, 'is_E')
    error('Please specify if Gi is induced by Ei.')
end

if ~isfield(para,'rho_outer')
    para.rho_outer = rho_outer_default;        
end

if ~isfield(para, 'max_iter')
    para.max_iter = max_iter_default;    
end

if ~isfield(para, 'tol_outer')
    para.tol_outer = tol_outer_default;   
end

if ~ isfield(para, 'lasso_method')
    para.lasso_method = lasso_method_default;   
end

if ~isfield(para, 'lasso_tol')
    para.lasso_tol = lasso_tol_default;
end

if ~isfield(para, 'lasso_max_iter')
    para.lasso_tol = lasso_max_iter_default;
end

rho_outer = para.rho_outer;
N_outer = para.max_iter;
tol_outer = para.tol_outer;
lasso_method = para.lasso_method; %%%%%%%%%%%%%%%%%%%%

%% parameters for my_lasso2()
para_lasso.max_iter = para.lasso_max_iter; 
para_lasso.tol = para.lasso_tol;
para_lasso.method = lasso_method;

if strcmp(lasso_method, 'FISTA')
    % FISTA
    % H circulant does not matter
    isCirculant = [];
    if para.preconditioned
        para_lasso.L = 1; % this is biggest singular value of H'H
    else
        s1 = svd(G1'*G1);
        s1 = diag(s1);
        s2 = svd(G2'*G2);
        s2 = diag(s2);
        para_lasso.L = s1(1)*s2(1);
    end
elseif strcmp(lasso_method, 'ADMM')
    % ADMM
    if ~isfield(para, 'lasso_rho')
        % if para.lasso_rho not given
        para.lasso_rho = lasso_rho_default;
    end
    para_lasso.rho = para.lasso_rho; 
    para_lasso.E = para.is_E;

    if para.preconditioned
        % ADMM and preconditioned, will use svd, which is already
        % precomputed in gen_matrix_sep_2d_con()
        isCirculant = false;
        % singular vectors of G1 or G1'G1, provided by gen_matrix_sep_2d_con
        para_lasso.V1 = para.V_G1; 
        % singular vectors of G2 or G2'G2, provided by gen_matrix_sep_2d_con
        para_lasso.V2 = para.V_G2; 
        para_lasso.Sig = para.Sig; %%%%%%%%%%%%%%%%%%%
        if para.is_E 
            % preconditioned, use Ei
            E1 = para.E1;
            E2 = para.E2;
            para_lasso.E1 = E1;
            para_lasso.E2 = E2;
            [n1, ~] = size(E1);
            [n2, ~] = size(E2);
        end

    elseif para.is_E
        % not preconditioned, and use Ei
        para_lasso.E = true;
        E1 = para.E1;
        E2 = para.E2;
        para_lasso.E1 = E1;
        para_lasso.E2 = E2;
        [n1, ~] = size(E1);
        [n2, ~] = size(E2);
        if is_circulant(E1) && is_circulant(E2) % case 1: Ei circ
            isCirculant = true;
            d1 = abs(fft(E1(:,1))).^2;
            d2 = abs(fft(E2(:,1))).^2;
            Lc = kron(ones(m1/n1, m2/n2), d1 * d2');
            para_lasso.coef = Lc; 
        else % case 2: Ei not circ
            isCirculant = false;
            [~, eS1, W1] = svd(E1' * E1);
            S1 = kron(eye(m1/n1), eS1);
            S1 = diag(S1); % m1 by 1
            para_lasso.V1 = kron(eye(m1/n1), W1);

            [~, eS2, W2] = svd(E2' * E2);
            S2 = kron(eye(m2/n2), eS2);
            S2 = diag(S2); % m2 by 1
            para_lasso.V2 = kron(eye(m2/n2), W2);
            para_lasso.Sig = S1 * S2'; % m1 by m2
        end
        
    elseif  is_circulant(G1) && is_circulant(G2) 
        % not preconditioned, uses Gi's, circulant
        isCirculant = true;
        D1 = abs(fft(G1(:,1))).^2;
        D2 = abs(fft(G2(:,1))).^2;
        para_lasso.coef = D1 * D2'; 
    
    else
        % uses Gi's, not circulant, not preconditioned
        isCirculant = false;
        [para_lasso.V1, sig1] = pref(G1);
        [para_lasso.V2, sig2] = pref(G2);
        para_lasso.Sig = sig1 * sig2'; % m1 by m2

    end
    
    
end
para_lasso.isCirculant = isCirculant;
para.isCirculant = isCirculant;

%% initialization and main loop
L = zeros(m1, m2, K);
S = zeros(p1, p2, K);
U = zeros(m1, m2, K);

RelChg = 1;
count_outer = 0;


while RelChg > tol_outer && count_outer < N_outer
    Slast = S;
    Llast = L;    
    % update L
    HS = bilinear_framewise(S, G1, G2');    
    L = SVT(reshape(M - HS - U, [m1*m2, K]), 1/rho_outer);
    L = reshape(L, [m1, m2, K]);
    
    % update S
    
    %[~,~, S] = lasso2(G1, G2, M - U - L, lam/rho_outer, para_lasso);
    [S, ~, ~] = my_lasso2(G1, G2, M - U - L, lam/rho_outer, para_lasso);
    
    % update U
    HS = bilinear_framewise(S, G1, G2');
    U = U + L + HS - M;
    count_outer = count_outer + 1;
    

    % % Check convergence
    % % finding the relative error
    
    Ldn = norm(L - Llast, 'fro');
    Sdn = norm(S - Slast, 'fro');
    Ln = norm(Llast, 'fro');
    Sn = norm(Slast, 'fro');
    % 
    % % updating stopping critera
    top = (Ldn^2 + Sdn^2)^0.5;
    bottom = ((Ln^2 + Sn^2)^0.5 + 1);
    RelChg =  top / bottom;
    %     

end

output.L = L;
output.S = S;
output.count_outer = count_outer;
output.para = para;
end

%% helper functions

function v = bilinear_framewise(V, left, right)
    % performs the bilinear frame-wise transformation on a tensor V.
    %
    % Inputs:
    %   V     - an m1 x m2 x k tensor 
    %   left  - a p x m1 matrix to be applied on the left of each frame
    %   right - a m2 x q matrix to be applied on the right of each frame
    %
    % Output:
    %   v     - a p x q x k tensor where each frame is transformed as left * V(:,:,i) * right

    % validate input dimensions
    [m1_V, m2_V, ~] = size(V);
    [~, m1_left] = size(left);
    [m2_right, ~] = size(right);

    if m1_left ~= m1_V
        error('Number of columns of left (%d) must match first dimension of V (%d).', m1_left, m1_V);
    end
    if m2_right ~= m2_V
        error('Number of rows of right (%d) must match second dimension of V (%d).', m2_right, m2_V);
    end

    LV = pagemtimes(left, V);        % Size: [p, m2_V, k]

    v = pagemtimes(LV, right);       % Size: [p, q, k]
end


function flag = is_circulant(A)
    [m, n] = size(A);
    
    % we need A to be square if circulant
    if m ~= n
        flag = false;
        return;
    end

    first_row = A(1, :);
    
    % check if each row is a shift of the first row
    for i = 2:m
        expected_row = circshift(first_row, [0, i-1]);
        if any(A(i, :) ~= expected_row)
            flag = false;
            return;
        end
    end
    flag = true;
end


function [V, sig] = pref(A)
% prefactorization of A
% A is m by p
% [~, sig, V] = svd(A'*A)
% V is square p by p
% sig is p by 1


[m, p] = size(A);

if p < m % tall
   [~, sig, V] = svd(A'*A); % V is p by p       
   sig = diag(sig); % p by 1
            
else % fat, m smaller
   [~, s, V] = svd(A); % V is p by p 
   s = diag(s); % m by 1
   sig = zeros(p, 1);
   sig(1:length(s)) = (abs(s)).^2;
end
end















